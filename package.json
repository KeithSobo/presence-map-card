{
  "name": "presence-map-card",
  "version": "2026.10.1",
  "description": "Multi-sensor mmWave presence radar and floor-plan custom card for Home Assistant",
  "type": "module",
  "main": "dist/presence-map-card.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "esbuild src/presence-map-card.ts --bundle --format=esm --target=es2020 --outfile=dist/presence-map-card.js && node scripts/generate-version.js",
    "generate:version": "node scripts/generate-version.js",
    "validate:release": "node scripts/validate-release.js",
    "watch": "esbuild src/presence-map-card.ts --bundle --format=esm --target=es2020 --outfile=dist/presence-map-card.js --sourcemap --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KeithSobo/presence-map-card.git"
  },
  "keywords": [
    "home-assistant",
    "lovelace",
    "custom-card",
    "hacs",
    "mmwave",
    "presence",
    "radar",
    "floorplan"
  ],
  "author": "Keith Sobolewski",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "@vitest/coverage-v8": "^4.0.18",
    "esbuild": "^0.27.2",
    "eslint": "^9.20.1",
    "eslint-config-prettier": "^10.0.1",
    "globals": "^15.15.0",
    "happy-dom": "^20.8.3",
    "prettier": "^3.5.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^4.0.18"
  }
}
